# Copy to .env and adjust, then: docker compose up -d --build

# --- Postgres ---
POSTGRES_PASSWORD=elastalert

# --- Keycloak ---
KEYCLOAK_ADMIN_PASSWORD=admin

# ⭐ Single source of truth for the Keycloak base URL.
# This URL must be reachable from BOTH:
#   - the browser (login redirect), AND
#   - the backend container (token issuer check + JWKS fetch).
# => Use the host machine's LAN IP, NOT "localhost" and NOT the internal name "keycloak".
#    (localhost works only in the browser; "keycloak" works only inside the network.)
# 예) 서버에서 docker compose 를 띄우고 다른 PC 브라우저로 접속:
KEYCLOAK_URL=http://10.21.15.116:8080
KEYCLOAK_REALM=elastalert
KEYCLOAK_CLIENT=elastalert-web

# CORS for the backend API
CORS_ORIGIN=*

# NOTE: VITE_* values are baked into the frontend at BUILD time. After changing
# KEYCLOAK_URL you must rebuild the frontend:  docker compose up -d --build frontend
