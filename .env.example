# Copy to .env and adjust.

# Postgres
POSTGRES_PASSWORD=elastalert

# Keycloak
KEYCLOAK_ADMIN_PASSWORD=admin

# OIDC (backend token validation) — issuer must be reachable from the backend container.
OIDC_ISSUER=http://keycloak:8080/realms/elastalert
OIDC_AUDIENCE=elastalert-web

# Frontend (Vite) — set at *build time* (used by browser, so it must be a URL
# the browser can reach; "localhost" only works if the browser is on the same host).
# 예) 서버에서 docker compose 를 띄우고 다른 PC 브라우저로 접속한다면:
#   VITE_KEYCLOAK_URL=http://10.21.15.116:8080
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=elastalert
VITE_KEYCLOAK_CLIENT=elastalert-web

CORS_ORIGIN=*
